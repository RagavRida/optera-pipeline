OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# The OpenAI configuration measured in results/openai/.
OPTERA_BASELINE_MODEL=gpt-4o
OPTERA_ROUTER_MODEL=gpt-4o-mini
OPTERA_EXTRACT_MODEL=gpt-4o

