# ---- Anthropic (default provider) ----
ANTHROPIC_API_KEY=sk-ant-...
# Optional: point at a gateway/proxy instead of the public API
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---- OpenAI (optional second provider) ----
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Model roles. Any model in optera/pricing.json can fill any role, so you
# ---- can run the whole comparison cross-vendor without touching code.
# OPTERA_BASELINE_MODEL=claude-opus-4-5-20251101
# OPTERA_ROUTER_MODEL=claude-haiku-4-5-20251001
# OPTERA_CHEAP_MODEL=claude-haiku-4-5-20251001
# OPTERA_MID_MODEL=claude-sonnet-4-5-20250929
# OPTERA_STRONG_MODEL=claude-opus-4-5-20251101

# ---- Tunables ----
# OPTERA_ROUTER_MAX_DIM=384
# OPTERA_ESCALATION_THRESHOLD=0.70
# OPTERA_PHASH_THRESHOLD=5
